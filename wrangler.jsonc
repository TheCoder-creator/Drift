{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "horizon-chromium",
  "main": "src/index.js",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
